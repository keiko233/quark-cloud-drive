{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@quark/config": ["./packages/config/src/index.ts"],
      "@quark/contract": ["./packages/contract/src/index.ts"],
      "@quark/contract/schemas": ["./packages/contract/src/schemas.ts"],
      "@quark/contract/server": ["./packages/contract/src/server.ts"],
      "@quark/contract/client": ["./packages/contract/src/client.ts"],
      "@quark/manager": ["./packages/manager/src/index.ts"],
      "@quark/drive": ["./packages/drive/src/index.ts"],
      "@quark/service": ["./packages/service/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "data", "**/data"]
}

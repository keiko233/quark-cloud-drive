{
  "imports": {
    "@libs/logger": "jsr:@libs/logger@^3.1.10",
    "@orpc/contract": "npm:@orpc/contract@^1.15.0",
    "@orpc/openapi": "npm:@orpc/openapi@^1.15.0",
    "@orpc/server": "npm:@orpc/server@^1.15.0",
    "@orpc/zod": "npm:@orpc/zod@^1.15.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "hono": "npm:hono@^4.13.5",
    "playwright": "npm:playwright@^1.62.1"
  },
  "tasks": {
    "dev": "docker compose --project-directory ../.. -f ../../docker-compose.yaml up --build",
    "dev:api": "deno run --watch -A src/main.ts",
    "start": "deno run -A src/main.ts",
    "test": "deno test -A",
    "postinstall": "deno run -A playwright install --with-deps chromium",
    "download-client": "deno run -A download-client.ts"
  }
}

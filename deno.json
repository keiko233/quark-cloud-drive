{
  "workspace": ["./apps/*", "./packages/*"],
  "fmt": {
    "exclude": ["data"]
  },
  "lint": {
    "exclude": ["data"]
  },
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno check apps/app/src/main.ts",
    "test": "deno test -A --unstable-kv apps packages",
    "dev": "deno task --cwd apps/app dev",
    "test:e2e": "QUARK_E2E=1 deno test -A --unstable-kv packages/drive/src/actions/list-file.e2e.test.ts packages/drive/src/actions/download.e2e.test.ts"
  }
}

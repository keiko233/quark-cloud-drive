# ── Deployment ────────────────────────────────────────────────────────────────
# Docker resource limits for the app container.
DOCKER_CPUS=2.0
DOCKER_MEMORY=4g

# Wine runtime used for the bundled Quark build (run-quark.sh default).
QUARK_RUNTIME=spark

# Use Xvfb by default. Set xorg with a GPU device mount if needed.
QUARK_DISPLAY=xvfb
MESA_LOADER_DRIVER_OVERRIDE=

# ── App ───────────────────────────────────────────────────────────────────────
# Public API + OpenAPI docs + MCP + noVNC page.
SERVER_PORT=3000
# CDP proxy port (DevTools page + host-side development).
CDP_PROXY_PORT=9223

# Cold-start Quark automatically when the app boots.
QUARK_AUTOSTART=true

# ── Session ───────────────────────────────────────────────────────────────────
# Internal CDP port. The optional diagnostic proxy uses CDP_PROXY_PORT.
# CDP_URL=http://127.0.0.1:9222
VNC_URL=http://127.0.0.1:5900
# Optional noVNC asset override; empty serves the bundled @novnc/novnc package.
NOVNC_STATIC_DIR=

RECONNECT_INTERVAL_MS=5000
CDP_READY_TIMEOUT_MS=30000
CDP_READY_POLL_MS=500

# ── Idle policy ───────────────────────────────────────────────────────────────
CLIENT_IDLE_MINIMIZE_AFTER_MS=300000
CLIENT_IDLE_STOP_AFTER_MS=1800000
CLIENT_IDLE_CHECK_INTERVAL_MS=10000

# ── Operation queue ───────────────────────────────────────────────────────────
QUEUE_OPERATION_TIMEOUT_MS=60000
QUEUE_MAX_WAITING=100

# ── Persistence / logging ─────────────────────────────────────────────────────
QUARK_KV_PATH=./data/kv.sqlite3
LOG_LEVEL=info

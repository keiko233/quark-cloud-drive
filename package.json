{
  "name": "quark-cloud-drive",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run apps/app/src/main.ts",
    "dev": "bun run --watch apps/app/src/main.ts",
    "test": "bun test",
    "test:e2e": "QUARK_E2E=1 bun test packages/drive/src/actions/list-file.e2e.test.ts packages/drive/src/actions/download.e2e.test.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}

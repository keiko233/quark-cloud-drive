# ── Common / deployment ───────────────────────────────────────────────────────
# Docker resource limits for both containers.
DOCKER_CPUS=2.0
DOCKER_MEMORY=4g

# ── quark-docker (Wine/Electron Quark instance + manager) ────────────────────
# Set before startup, e.g. MESA_LOADER_DRIVER_OVERRIDE=iris or radeonsi.
MESA_LOADER_DRIVER_OVERRIDE=

# Manager REST API listen port (FastAPI). /openapi.json and /spec.json exposed.
QUARK_API_PORT=8080
# Cold-start Quark automatically when the manager boots.
QUARK_AUTOSTART=true
# Two-stage idle policy: minimize window first, then stop the process (seconds).
QUARK_IDLE_MINIMIZE_TIMEOUT=300
QUARK_IDLE_STOP_TIMEOUT=1800
# Monitor sampling cadence (seconds).
QUARK_IDLE_CHECK_INTERVAL=10
# Process-tree CPU% above this counts as "busy" (background uploads, etc.).
QUARK_CPU_BUSY_THRESHOLD=15.0
# Restore the window automatically when a CDP client connects while minimized.
QUARK_RESTORE_ON_CDP=true

# Host ports mapped into quark-docker.
NOVNC_PORT=6080
REMOTE_DEBUGGING_PORT=9222

# ── quark-cdp-client (Deno CDP -> HTTP API) ──────────────────────────────────
# Local TCP forward: 127.0.0.1:CDP_FORWARD_LOCAL_PORT -> quark-docker:CDP_FORWARD_PORT.
CDP_FORWARD_HOST=quark-docker
CDP_FORWARD_PORT=9223
CDP_FORWARD_LOCAL_PORT=9222

# Manager REST API the client talks to (also exposed as /manager/* passthrough).
QUARK_MANAGER_URL=http://quark-docker:8080

# Max time to wait for Quark's CDP port to come online after /start.
QUARK_CDP_READY_TIMEOUT_MS=30000
QUARK_CDP_READY_POLL_MS=500

# Client HTTP API port.
SERVER_PORT=3000

{
  "imports": {
    "@libs/logger": "jsr:@libs/logger@^3.1.10",
    "@orpc/contract": "npm:@orpc/contract@^1.14.2",
    "@orpc/openapi": "npm:@orpc/openapi@^1.14.2",
    "@orpc/server": "npm:@orpc/server@^1.14.2",
    "@orpc/zod": "npm:@orpc/zod@^1.14.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "hono": "npm:hono@^4.12.18",
    "playwright": "npm:playwright@^1.59.1"
  },
  "tasks": {
    "dev": "deno run --watch -A src/main.ts",
    "start": "deno run -A src/main.ts",
    "test": "deno test -A",
    "postinstall": "deno run -A playwright install --with-deps chromium",
    "download-client": "deno run -A download-client.ts"
  }
}

# Exclude everything not needed by the app Dockerfile. Do NOT exclude
# apps/app/wineprefix.tar.zst — it is bind-mounted by the Dockerfile.
.git
.github
docs
data
apps/*/data
*.sqlite3
wine-data*
downloads
.env
node_modules
# Nested workspace installs (bun's isolated store lives under the root one, and
# the per-package dirs are symlinks into it — copying them into the image would
# carry host-only links).
**/node_modules
# Leftovers from prepare-wineprefix.sh (the real artifact is the .tar.zst).
apps/*/.prepared

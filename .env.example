# ── Common / deployment ───────────────────────────────────────────────────────
# Docker resource limits for both containers.
DOCKER_CPUS=2.0
DOCKER_MEMORY=4g

# ── apps/server (Wine/Electron Quark instance + manager, Docker) ─────────────
# Set before `docker compose up`, e.g. MESA_LOADER_DRIVER_OVERRIDE=iris.
MESA_LOADER_DRIVER_OVERRIDE=

# Manager REST API listen port. /openapi.json is exposed.
QUARK_API_PORT=8080
# Cold-start Quark automatically when the manager boots.
QUARK_AUTOSTART=true
# ── apps/client (Deno CDP -> HTTP API) ──────────────────────────────────────
# These values are for running apps/client directly on the host while the
# server container publishes 8080 and 9223. Inside the compose client service,
# docker-compose.yaml overrides them with http://server:*.
SERVER_URL=http://127.0.0.1:8080
CDP_URL=http://127.0.0.1:9223
VNC_URL=http://127.0.0.1:5900
SERVER_PORT=3000

RECONNECT_INTERVAL_MS=5000
CDP_READY_TIMEOUT_MS=30000
CDP_READY_POLL_MS=500
CLIENT_IDLE_MINIMIZE_AFTER_MS=300000
CLIENT_IDLE_STOP_AFTER_MS=1800000
CLIENT_IDLE_CHECK_INTERVAL_MS=10000
QUEUE_OPERATION_TIMEOUT_MS=60000
QUEUE_MAX_WAITING=100
CLIENT_KV_PATH=./data/kv.sqlite3
LOG_LEVEL=info
